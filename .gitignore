__pycache__/
*.pyc
.pytest_cache/
# Hypothesis writes its constants cache here even with database=None (#489 property tests); CI sends it to RUNNER_TEMP.
.hypothesis/
*.zip
# Raw blobs live in the actions cache / run artifact (multi-GB); manifests + STORE_INDEX stay in git.
implementation/data/raw/blobs/*
!implementation/data/raw/blobs/.gitkeep
implementation/data/raw/history/*
!implementation/data/raw/history/.gitkeep
