diff --git a/implementation/src/investment_system/evl/stamped.py b/implementation/src/investment_system/evl/stamped.py
new file mode 100644
index 0000000..af312f3
--- /dev/null
+++ b/implementation/src/investment_system/evl/stamped.py
@@ -0,0 +1,47 @@
+"""Research-only PIT lineage sidecar for the unchanged legacy Technical/Macro engines.
+
+TRIAL PROTOTYPE (option B audit). Core TechnicalSnapshot/MacroSnapshot schemas and the
+engine sources stay canonical; input-derived lineage is carried as separate evidence next
+to the unmodified legacy output. No new scoring rule; availability is never taken from
+as_of (contracts.lineage.derived_lineage).
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime
+
+from ..contracts.lineage import StampedValue, derived_lineage
+from ..contracts.models import MacroSnapshot, QGVSnapshot, TechnicalSnapshot
+from ..macro.engine import MacroEngine
+from ..technical.engine import TechnicalEngine
+
+
+@dataclass(frozen=True)
+class Lineage:
+    available_at: datetime
+    data_stamp_refs: tuple[str, ...]
+    source_vintages: tuple[tuple[str, str], ...]
+    input_hash: str
+
+
+def technical_stamped(company_id: str, as_of: datetime, returns: tuple[StampedValue, ...],
+                      qgv: QGVSnapshot | None = None,
+                      synthetic: bool = False) -> tuple[TechnicalSnapshot, Lineage]:
+    if not returns:
+        raise ValueError("strict Technical evaluation requires returns")
+    times = tuple(row.measured_at for row in returns)
+    if len(set(times)) != len(times) or times != tuple(sorted(times)):
+        raise ValueError("returns must be unique and chronological")
+    lineage = derived_lineage({str(i): value for i, value in enumerate(returns)},
+                              as_of, synthetic=synthetic)
+    output = TechnicalEngine().evaluate(company_id, as_of, [r.value for r in returns], qgv, synthetic)
+    return output, Lineage(**lineage)
+
+
+def macro_stamped(as_of: datetime, indicators: dict[str, StampedValue],
+                  synthetic: bool = False) -> tuple[MacroSnapshot, Lineage]:
+    if set(indicators) != {"growth", "inflation"}:
+        raise ValueError("strict Macro evaluation requires growth and inflation")
+    lineage = derived_lineage(indicators, as_of, synthetic=synthetic)
+    output = MacroEngine().evaluate(as_of, {k: v.value for k, v in indicators.items()}, synthetic)
+    return output, Lineage(**lineage)
