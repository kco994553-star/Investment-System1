    "STANDARD": {
      "scope": ["additive contract field", "serialization", "adapter", "non-semantic runtime plumbing", "backward-compatible metadata"],
      "semantic_change": false,
      "verification": ["targeted", "compatibility", "affected regression"],
      "stop_after_pass": true,
      "default_full_regression": false
    },
    "CRITICAL": {
      "scope": ["factor definition", "Requiredness", "Applicability", "Missing-Data semantics", "aggregation", "normalization", "weighting", "composite", "calibration", "threshold", "scoring", "PIT/OOS", "Official lifecycle"],
