  "full_regression_priority": ["methodology change", "shared QGV runtime change", "composite change", "calibration milestone", "production candidate", "affected scope unclear"],
  "agent_budget": {
    "default_auditors": 1,
    "additional_independent_specialists_when_needed": 1,
    "more_reviewers_only": "CRITICAL decisions actually requiring distinct perspectives",
    "agent_count_is_confidence": false
  },
  "decision_package_fields": ["exact unresolved question", "evidence", "options", "compatibility impact", "recommendation"],
  "reopen_decided_item_without_new_evidence": false,
  "audit_to_closure": ["finding", "bounded repair/handoff", "targeted verification", "close"],
  "main_handoff_dispositions": ["PASS", "FINDING", "BLOCKER", "D3_REQUIRED"],
  "report_fields": ["Verification Lane", "semantic changes", "reused evidence", "new verification", "skipped expensive verification", "findings closed", "findings opened", "net QGV blockers", "D3 여부"],
