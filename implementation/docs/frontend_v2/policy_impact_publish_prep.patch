+"""Public `policy-impact.json` boundary (4.5 정책·지정학; prepared 2026-11-07, applied only after owner approval).
+
+The file is Codex's `policy-impact-view/1` output of `build(..., public=True)`, published unchanged. This module decides
+nothing about policies: it re-runs Codex's own contract (`research.policy_impact.contract.validate`) on the displayed
+bundle and adds the public-only conditions that a stand-in or a private build would break:
+
+- REAL_REVIEWED only (the bundle and every record): a synthetic file is never published in place of the real one;
+- the public projection holds: no UNREVIEWED record, no CANDIDATE exposure, every source VERIFIED;
+- company ids are the existing published universe (`universe_codes.source_codes()`), macro ids only the published
+  `macro-evidence.json` series (the existing allowlist; availability alone is not permission);
+- review records carry agent / role labels only (no spaces, no address);
+- no score or gate effect, no point-in-time claim, and a size cap.
+
+Only fixed codes leave this module (ValueError(code)); no value from the file is printed.
+"""
+from __future__ import annotations
+
+import json
+import re
+
+from ..macro import evidence_sources as macro_sources
+from ..research.policy_impact import contract as policy_contract
+from ..universe.universe_codes import source_codes
+
+FILENAME = 'policy-impact.json'
+VIEW_SCHEMA = 'policy-impact-view/1'
+VIEW_KEYS = frozenset({'as_of', 'bundle', 'current_policy_revisions', 'historical_pit_eligible', 'query_timezone',
+                       'schema_version'})
+MAX_BYTES = 1024 * 1024
+GROUPS = ('sources', 'policies', 'exposures', 'hypotheses')
+# Review records name an agent or role label (e.g. an AI reviewer id), never a person's name or address.
+LABEL = re.compile(r'[A-Za-z][A-Za-z0-9_-]{0,63}')
+
+
+def _need(ok, code):
+    if not ok:
+        raise ValueError(code)
+
+
+def require_policy_impact_public(value) -> None:
+    _need(type(value) is dict and set(value) == VIEW_KEYS, 'POLICY_VIEW_KEYS')
+    _need(value['schema_version'] == VIEW_SCHEMA, 'POLICY_VIEW_SCHEMA')
+    _need(value['historical_pit_eligible'] is False, 'POLICY_VIEW_PIT')
+    encoded = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('utf-8')
+    _need(len(encoded) <= MAX_BYTES, 'POLICY_VIEW_TOO_LARGE')
+    bundle = value['bundle']
+    _need(type(bundle) is dict, 'POLICY_VIEW_BUNDLE')
+    try:
+        policy_contract.validate(bundle, frozenset(source_codes()), tuple(macro_sources.SERIES_IDS))
+    except ValueError as exc:
+        raise ValueError('POLICY_CONTRACT') from exc
+    _need(bundle['data_kind'] == 'REAL_REVIEWED', 'POLICY_NOT_REAL_REVIEWED')
+    _need(bundle['historical_pit_eligible'] is False, 'POLICY_VIEW_PIT')
+    _need(bundle['score_effect'] == 'NONE' and bundle['gate_effect'] == 'NONE', 'POLICY_EFFECT')
+    for group in GROUPS:
+        _need(all(r['data_kind'] == 'REAL_REVIEWED' for r in bundle[group]), 'POLICY_NOT_REAL_REVIEWED')
+    _need(all(s['verification_status'] == 'VERIFIED' for s in bundle['sources']), 'POLICY_UNVERIFIED_SOURCE')
+    for group in ('policies', 'exposures', 'hypotheses'):
+        _need(all(r['review_status'] != 'UNREVIEWED' for r in bundle[group]), 'POLICY_UNREVIEWED')
+    _need(all(e['evidence_status'] != 'CANDIDATE' for e in bundle['exposures']), 'POLICY_CANDIDATE_EXPOSURE')
+    _need(all(LABEL.fullmatch(r[k]) for r in bundle['review_records'] for k in ('author', 'reviewer')), 'POLICY_REVIEW_LABEL')
+    current = value['current_policy_revisions']
+    shown = {(p['policy_id'], p['revision_id']) for p in bundle['policies']}
+    _need(type(current) is dict and {p for p, _ in shown} == set(current)
+          and all((p, r) in shown for p, r in current.items()), 'POLICY_CURRENT_REVISIONS')
