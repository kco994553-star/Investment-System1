index 00000000..a405ebd6
--- /dev/null
+++ b/implementation/tests/test_policy_impact_public.py
@@ -0,0 +1,93 @@
+"""Public policy-impact.json boundary (prepared 2026-11-07; applied only after owner approval).
+
+Synthetic files are refused (never a stand-in for the real one). A REAL_REVIEWED-labelled Codex public build, made in
+memory from the synthetic job only to exercise the rules, passes; each public-only condition then fails closed."""
+import copy
+import json
+from pathlib import Path
+
+import pytest
+
+from investment_system.product.policy_impact_public import require_policy_impact_public as require
+from investment_system.research.policy_impact import build
+from investment_system.universe.universe_codes import source_codes
+
+ROOT = Path(__file__).resolve().parents[1]
+D = ROOT / 'docs/research/policy_impact'
+
+
+def _code(view):
+    try:
+        require(view)
+    except ValueError as exc:
+        return str(exc)
+    return 'ACCEPT'
+
+
+def _relabelled_view():
+    j = json.loads((D / 'synthetic-job.json').read_text())
+    text = json.dumps(j['bundle'])
+    codes = source_codes()
+    for i, cid in enumerate(sorted(j['company_ids'])):
+        text = text.replace(json.dumps(cid), json.dumps(codes[i]))
+    bundle = json.loads(text.replace('"SYNTHETIC"', '"REAL_REVIEWED"'))
+    return build(bundle, codes, j['as_of'], public=True, public_macro_ids=[])
+
+
+def test_synthetic_files_are_refused():
+    assert _code(json.loads((D / 'synthetic-view.json').read_text())) != 'ACCEPT'
+    variants = json.loads((ROOT / 'tests/fixtures/policy_impact_view_main_variants.json').read_text())['variants']
+    assert all(_code(v) != 'ACCEPT' for v in variants.values())
+
+
+def test_real_reviewed_public_build_passes_and_each_rule_fails_closed():
+    view = _relabelled_view()
+    assert view['bundle']['policies'], 'the test build keeps policies'
+    assert _code(view) == 'ACCEPT'
+
+    def broken(edit):
+        v = copy.deepcopy(view)
+        edit(v)
+        return _code(v)
+
+    assert broken(lambda v: v.update(extra=1)) == 'POLICY_VIEW_KEYS'
+    assert broken(lambda v: v.update(historical_pit_eligible=True)) == 'POLICY_VIEW_PIT'
+    assert broken(lambda v: v['bundle'].update(data_kind='SYNTHETIC')) in {'POLICY_CONTRACT', 'POLICY_NOT_REAL_REVIEWED'}
+    assert broken(lambda v: v['bundle']['sources'][0].update(verification_status='SOURCE_UNVERIFIED')) == 'POLICY_UNVERIFIED_SOURCE'
+    assert broken(lambda v: v['bundle']['policies'][0].update(review_status='UNREVIEWED')) == 'POLICY_UNREVIEWED'
+    assert broken(lambda v: v['current_policy_revisions'].update(nope='1')) == 'POLICY_CURRENT_REVISIONS'
+    if view['bundle']['review_records']:
+        for label in ('A Person', 'someone' + chr(64) + 'example.org', ''):
+            assert broken(lambda v: v['bundle']['review_records'][0].update(reviewer=label)) in {'POLICY_REVIEW_LABEL', 'POLICY_CONTRACT'}
+    assert broken(lambda v: v['bundle']['policies'][0].update(url='x')) == 'POLICY_CONTRACT'
+    if view['bundle']['exposures']:
+        assert broken(lambda v: v['bundle']['exposures'][0].update(company_id='NASDAQ:NOTLISTEDX')) == 'POLICY_CONTRACT'
+        assert broken(lambda v: v['bundle']['exposures'][0].update(evidence_status='CANDIDATE')) in {'POLICY_CONTRACT', 'POLICY_CANDIDATE_EXPOSURE'}
+    big = copy.deepcopy(view)
+    big['bundle']['policies'][0]['scope_description'] = 'x' * (1024 * 1024)
+    assert _code(big) in {'POLICY_VIEW_TOO_LARGE', 'POLICY_CONTRACT'}
+
+
+def test_module_prints_and_fetches_nothing():
+    src = (ROOT / 'src/investment_system/product/policy_impact_public.py').read_text()
+    for banned in ('print(', 'urllib', 'requests', 'open(', 'providers'):
+        assert banned not in src, banned
+
+
+def test_publish_step_copies_only_an_approved_file_unchanged(tmp_path, capsys):
+    import importlib.util
+    spec = importlib.util.spec_from_file_location('policy_impact_publish', ROOT / 'tools/policy_impact_publish.py')
+    tool = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(tool)
+    out = tmp_path / 'site'
+    assert tool.publish(out, source=tmp_path / 'absent.json') == 0 and not (out / 'policy-impact.json').exists()
+    synthetic = tmp_path / 'synthetic.json'
+    synthetic.write_bytes((D / 'synthetic-view.json').read_bytes())
+    assert tool.publish(out, source=synthetic) == 1 and not (out / 'policy-impact.json').exists()
+    approved = tmp_path / 'approved.json'
+    approved.write_text(json.dumps(_relabelled_view(), ensure_ascii=False))
+    assert tool.publish(out, source=approved) == 0
+    assert (out / 'policy-impact.json').read_bytes() == approved.read_bytes()
+    printed = capsys.readouterr().out
+    assert 'POLICY_IMPACT REFUSED' in printed and 'POLICY_IMPACT PUBLISHED' in printed and 'http' not in printed
+    assert not tool.SOURCE.exists(), 'no approved file is committed before the owner approves publication'
