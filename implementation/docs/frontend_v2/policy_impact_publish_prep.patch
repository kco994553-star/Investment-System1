@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Public `policy-impact.json` (4.5 정책·지정학): copy the owner-approved file into a Pages artifact, unchanged.
+
+The only source is `src/investment_system/product/policy_impact_public.json`, Codex's `build(..., public=True)` output
+committed after the owner approves it. Absent -> nothing is written (the screen shows 자료 없음; a synthetic file is
+never a stand-in). Present -> it must pass `require_policy_impact_public`, else the step fails and nothing is written.
+No fetch. Only fixed codes and counts are printed.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+from investment_system.product.policy_impact_public import FILENAME, require_policy_impact_public
+
+SOURCE = Path(__file__).resolve().parents[1] / 'src/investment_system/product/policy_impact_public.json'
+
+
+def publish(out: Path, *, source: Path = SOURCE) -> int:
+    if not source.is_file():
+        print('POLICY_IMPACT NOT_PUBLISHED no_approved_file')
+        return 0
+    body = source.read_bytes()
+    try:
+        value = json.loads(body.decode('utf-8'))
+        require_policy_impact_public(value)
+    except ValueError as exc:
+        code = str(exc) if str(exc).startswith('POLICY_') else 'NOT_JSON'
+        print('POLICY_IMPACT REFUSED ' + code)
+        return 1
+    out.mkdir(parents=True, exist_ok=True)
+    (out / FILENAME).write_bytes(body)
+    b = value['bundle']
+    print('POLICY_IMPACT PUBLISHED policies=%d exposures=%d hypotheses=%d sources=%d' % (
+        len(value['current_policy_revisions']), len(b['exposures']), len(b['hypotheses']), len(b['sources'])))
+    return 0
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', required=True, type=Path)
+    return publish(parser.parse_args(argv).out)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
