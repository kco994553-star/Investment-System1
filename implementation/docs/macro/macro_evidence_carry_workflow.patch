@@ -316,11 +316,27 @@ jobs:
       # earlier inputs_as_of, is OLDER (refused); an artifact copy failing the strict reader is refused. A live publication
       # that is invalid or missing from the artifact withholds the publication only (PAGES_FRESHNESS_PUBLICATION_WITHHELD,
       # D-CV16 (a)) and the rest of the deploy goes on. qgv-official-status.json is never compared.
-      - name: Refuse to deploy public data older than the live Pages copy
+      # macro-evidence.json (owner 2026-11-07 4th): when the daily step withheld the file (its record says WITHHELD, e.g. only
+      # the collect-time read of the live copy failed), the verified live copy is carried into the artifact byte for byte
+      # with a CARRIED_LIVE record (tools/macro_evidence_carry.py), so the guard sees EQUAL instead of removing the live
+      # good copy. A failed live read carries nothing and stops the deploy; a damaged live copy or a confirmed absence
+      # carries nothing (WITHHELD / NOT_PUBLISHED as before). The guard rules are unchanged; the checked directory is then
+      # uploaded once and deployed, so what is deployed is exactly what was checked.
+      - name: Carry the verified live macro evidence copy into a withheld deploy artifact (byte for byte)
         run: |
           mkdir "$RUNNER_TEMP/deploy-check"
           tar -xf "$RUNNER_TEMP/pages-artifact/artifact.tar" -C "$RUNNER_TEMP/deploy-check"
-          python implementation/tools/pages_freshness_guard.py --artifact-dir "$RUNNER_TEMP/deploy-check"
+          python implementation/tools/macro_evidence_carry.py --artifact-dir "$RUNNER_TEMP/deploy-check"
+          python implementation/tools/pages_artifact_guard.py --artifact-dir "$RUNNER_TEMP/deploy-check"
+      - name: Refuse to deploy public data older than the live Pages copy
+        run: python implementation/tools/pages_freshness_guard.py --artifact-dir "$RUNNER_TEMP/deploy-check"
+      - name: Upload exactly the checked deploy directory as the Pages artifact this job deploys
+        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3
+        with:
+          path: ${{ runner.temp }}/deploy-check
+          name: github-pages-deploy
       - name: Deploy checked Pages artifact
         id: deployment
         uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4
+        with:
+          artifact_name: github-pages-deploy
